    25	def quaternion_matrix(x, y, z, w):
    26	    norm = math.sqrt(x * x + y * y + z * z + w * w)
    27	    if norm == 0:
    28	        raise ValueError("zero observed pose quaternion")
    29	    x, y, z, w = x / norm, y / norm, z / norm, w / norm
    30	    return np.array([
    31	        [1 - 2 * (y * y + z * z), 2 * (x * y + z * w), 2 * (x * z - y * w)],
    32	        [2 * (x * y - z * w), 1 - 2 * (x * x + z * z), 2 * (y * z + x * w)],
    33	        [2 * (x * z + y * w), 2 * (y * z - x * w), 1 - 2 * (x * x + y * y)],
    34	    ])
