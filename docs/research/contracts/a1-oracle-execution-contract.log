    39	def iou(first, second):
    40	    left, top = max(first[0], second[0]), max(first[1], second[1])
    41	    right, bottom = min(first[2], second[2]), min(first[3], second[3])
    42	    overlap = max(0, right - left) * max(0, bottom - top)
    43	    union = (first[2] - first[0]) * (first[3] - first[1]) + (second[2] - second[0]) * (second[3] - second[1]) - overlap
    44	    return overlap / union if union else 0.0
