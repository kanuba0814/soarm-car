Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 18; 21; 27
    Fixed Frame: base_link
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Floor
      Enabled: true
      Alpha: 0.30
      Cell Size: 0.25
      Color: 90; 98; 110
      Plane: XY
    - Class: rviz_default_plugins/RobotModel
      Name: Robot layout
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
    - Class: rviz_default_plugins/TF
      Name: Frames
      Enabled: false
      Show Names: true
    - Class: rviz_default_plugins/MarkerArray
      Name: State display
      Enabled: true
      Topic: /development/robot_state_markers
      Queue Size: 100
      Namespaces: {}
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 1.35
      Focal Point:
        X: 0.02
        Y: 0
        Z: 0.18
      Pitch: 0.48
      Yaw: 0.75
Window Geometry:
  Height: 850
  Width: 1180
  X: 80
  Y: 60
