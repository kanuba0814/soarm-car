<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="senior_akm_soarm101">
  <!-- ENU: +X forward, +Y left, +Z up. base_link is 62.5 mm above base_footprint. -->
  <xacro:property name="wheel_radius" value="0.0625"/><xacro:property name="wheelbase" value="0.345"/><xacro:property name="track" value="0.310"/>
  <material name="deck"><color rgba="0.78 0.80 0.82 1"/></material><material name="tire"><color rgba="0.03 0.03 0.03 1"/></material><material name="silver"><color rgba="0.62 0.64 0.67 1"/></material><material name="orange"><color rgba="0.95 0.40 0.05 1"/></material><material name="joint"><color rgba="0.18 0.19 0.21 1"/></material><material name="yellow"><color rgba="0.98 0.76 0.05 1"/></material><material name="cyan"><color rgba="0.05 0.75 0.85 1"/></material><material name="blue"><color rgba="0.08 0.30 0.80 1"/></material><material name="purple"><color rgba="0.50 0.18 0.65 1"/></material>
  <xacro:macro name="inertia_box" params="mass x y z"><inertial><mass value="${mass}"/><inertia ixx="${mass*(y*y+z*z)/12}" iyy="${mass*(x*x+z*z)/12}" izz="${mass*(x*x+y*y)/12}" ixy="0" ixz="0" iyz="0"/></inertial></xacro:macro>
  <xacro:macro name="box_link" params="name mass x y z material"><link name="${name}"><xacro:inertia_box mass="${mass}" x="${x}" y="${y}" z="${z}"/><visual><geometry><box size="${x} ${y} ${z}"/></geometry><material name="${material}"/></visual><collision><geometry><box size="${x} ${y} ${z}"/></geometry></collision></link></xacro:macro>
  <link name="base_footprint"/><xacro:box_link name="base_link" mass="5" x="0.400" y="0.260" z="0.040" material="joint"/><joint name="base_footprint_joint" type="fixed"><parent link="base_footprint"/><child link="base_link"/><origin xyz="0 0 ${wheel_radius}"/></joint>
  <xacro:box_link name="first_deck" mass="0.3" x="0.400" y="0.260" z="0.005" material="deck"/><joint name="first_deck_joint" type="fixed"><parent link="base_link"/><child link="first_deck"/><origin xyz="0 0 0.035"/></joint>
  <xacro:box_link name="second_deck" mass="0.4" x="0.400" y="0.300" z="0.005" material="deck"/><joint name="second_deck_joint" type="fixed"><parent link="base_link"/><child link="second_deck"/><origin xyz="0 0 0.100"/></joint>
  <xacro:box_link name="third_deck" mass="0.5" x="0.445" y="0.320" z="0.005" material="deck"/><joint name="third_deck_joint" type="fixed"><parent link="base_link"/><child link="third_deck"/><origin xyz="0 0 0.137"/></joint>
  <xacro:macro name="pillar" params="name parent x y z length"><link name="${name}"><visual><geometry><cylinder radius="0.008" length="${length}"/></geometry><material name="silver"/></visual></link><joint name="${name}_joint" type="fixed"><parent link="${parent}"/><child link="${name}"/><origin xyz="${x} ${y} ${z}"/></joint></xacro:macro>
  <xacro:pillar name="pillar_fl_lower" parent="first_deck" x="0.160" y="0.105" z="0.0325" length="0.060"/><xacro:pillar name="pillar_fr_lower" parent="first_deck" x="0.160" y="-0.105" z="0.0325" length="0.060"/><xacro:pillar name="pillar_rl_lower" parent="first_deck" x="-0.160" y="0.105" z="0.0325" length="0.060"/><xacro:pillar name="pillar_rr_lower" parent="first_deck" x="-0.160" y="-0.105" z="0.0325" length="0.060"/>
  <xacro:pillar name="pillar_fl_upper" parent="second_deck" x="0.160" y="0.120" z="0.0185" length="0.032"/><xacro:pillar name="pillar_fr_upper" parent="second_deck" x="0.160" y="-0.120" z="0.0185" length="0.032"/><xacro:pillar name="pillar_rl_upper" parent="second_deck" x="-0.160" y="0.120" z="0.0185" length="0.032"/><xacro:pillar name="pillar_rr_upper" parent="second_deck" x="-0.160" y="-0.120" z="0.0185" length="0.032"/>
  <xacro:macro name="wheel" params="side axle parent x y steering"><link name="${side}_${axle}_wheel"><inertial><mass value="0.35"/><inertia ixx="0.0008" iyy="0.00045" izz="0.0008" ixy="0" ixz="0" iyz="0"/></inertial><visual><origin rpy="-1.570796 0 0"/><geometry><cylinder radius="${wheel_radius}" length="0.040"/></geometry><material name="tire"/></visual><collision><origin rpy="-1.570796 0 0"/><geometry><cylinder radius="${wheel_radius}" length="0.040"/></geometry></collision></link><joint name="${side}_${axle}_wheel_joint" type="continuous"><parent link="${parent}"/><child link="${side}_${axle}_wheel"/><origin xyz="${x} ${y} 0"/><axis xyz="0 1 0"/></joint></xacro:macro>
  <xacro:macro name="front_wheel" params="side y"><xacro:box_link name="${side}_front_steering_link" mass="0.12" x="0.050" y="0.040" z="0.060" material="silver"/><joint name="${side}_front_steering_joint" type="revolute"><parent link="base_link"/><child link="${side}_front_steering_link"/><origin xyz="${wheelbase/2} ${y} 0"/><axis xyz="0 0 1"/><limit lower="-0.65" upper="0.65" effort="8" velocity="1.5"/></joint><xacro:wheel side="${side}" axle="front" parent="${side}_front_steering_link" x="0" y="0" steering="true"/></xacro:macro>
  <xacro:front_wheel side="left" y="${track/2}"/><xacro:front_wheel side="right" y="${-track/2}"/><xacro:wheel side="left" axle="rear" parent="base_link" x="${-wheelbase/2}" y="${track/2}" steering="false"/><xacro:wheel side="right" axle="rear" parent="base_link" x="${-wheelbase/2}" y="${-track/2}" steering="false"/>
  <xacro:box_link name="gyro_link" mass="0.05" x="0.040" y="0.040" z="0.020" material="purple"/><joint name="gyro_joint" type="fixed"><parent link="second_deck"/><child link="gyro_link"/><origin xyz="0 0 0.0185"/></joint>
  <link name="camera_link"><xacro:inertia_box mass="0.12" x="0.085" y="0.035" z="0.032"/><visual name="camera_body"><geometry><box size="0.085 0.035 0.032"/></geometry><material name="blue"/></visual><visual name="camera_lens"><origin xyz="0.043 0 0" rpy="0 1.570796 0"/><geometry><cylinder radius="0.012" length="0.004"/></geometry><material name="tire"/></visual><collision><geometry><box size="0.085 0.035 0.032"/></geometry></collision></link><joint name="camera_joint" type="fixed"><parent link="second_deck"/><child link="camera_link"/><origin xyz="0.1725 0 0.0185"/></joint>
  <link name="livox_frame"><visual><geometry><cylinder radius="0.036" length="0.060"/></geometry><material name="cyan"/></visual></link><joint name="livox_joint" type="fixed"><parent link="third_deck"/><child link="livox_frame"/><origin xyz="0 0 0.0325"/></joint>
  <xacro:box_link name="arm_mount" mass="0.35" x="0.10" y="0.10" z="0.035" material="joint"/><joint name="arm_mount_joint" type="fixed"><parent link="third_deck"/><child link="arm_mount"/><origin xyz="0.1725 0 0.0025"/></joint>
  <xacro:macro name="arm_link" params="name link_xyz link_size link_rpy"><link name="${name}"><visual name="joint_housing"><geometry><box size="0.050 0.045 0.045"/></geometry><material name="joint"/></visual><visual name="orange_link"><origin xyz="${link_xyz}" rpy="${link_rpy}"/><geometry><box size="${link_size}"/></geometry><material name="orange"/></visual></link></xacro:macro>
  <!-- These six origins/rpy and Z axes are the official so101_new_calib.urdf zero chain. -->
  <xacro:arm_link name="arm_shoulder" link_xyz="-0.0152 -0.00914 -0.0271" link_size="0.0647 0.025 0.025" link_rpy="0.3218 0 -2.599"/><joint name="arm_shoulder_pan" type="revolute"><parent link="arm_mount"/><child link="arm_shoulder"/><origin xyz="0.0388353 -0.000000009 0.0624" rpy="3.14159 0 -3.14159"/><axis xyz="0 0 1"/><limit lower="-1.91986" upper="1.91986" effort="10" velocity="2"/></joint>
  <xacro:arm_link name="arm_upper" link_xyz="-0.056285 -0.014 0" link_size="0.116 0.028 0.028" link_rpy="0 0 -2.898"/><joint name="arm_shoulder_lift" type="revolute"><parent link="arm_shoulder"/><child link="arm_upper"/><origin xyz="-0.0303992 -0.0182778 -0.0542" rpy="-1.5708 -1.5708 0"/><axis xyz="0 0 1"/><limit lower="-1.74533" upper="1.74533" effort="10" velocity="2"/></joint>
  <xacro:arm_link name="arm_forearm" link_xyz="-0.06745 0.0026 0" link_size="0.135 0.025 0.025" link_rpy="0 0 3.103"/><joint name="arm_elbow_flex" type="revolute"><parent link="arm_upper"/><child link="arm_forearm"/><origin xyz="-0.11257 -0.028 0" rpy="0 0 1.5708"/><axis xyz="0 0 1"/><limit lower="-1.69" upper="1.69" effort="10" velocity="2"/></joint>
  <xacro:arm_link name="arm_wrist" link_xyz="0 -0.03055 0.00905" link_size="0.0637 0.022 0.022" link_rpy="-0.288 0 1.5708"/><joint name="arm_wrist_flex" type="revolute"><parent link="arm_forearm"/><child link="arm_wrist"/><origin xyz="-0.1349 0.0052 0" rpy="0 0 -1.5708"/><axis xyz="0 0 1"/><limit lower="-1.65806" upper="1.65806" effort="10" velocity="2"/></joint>
  <xacro:box_link name="arm_gripper" mass="0.12" x="0.060" y="0.050" z="0.050" material="joint"/><joint name="arm_wrist_roll" type="revolute"><parent link="arm_wrist"/><child link="arm_gripper"/><origin xyz="0 -0.0611 0.0181" rpy="1.5708 0.0486795 3.14159"/><axis xyz="0 0 1"/><limit lower="-2.74385" upper="2.84121" effort="10" velocity="2"/></joint>
  <xacro:box_link name="left_finger" mass="0.03" x="0.070" y="0.012" z="0.018" material="yellow"/><joint name="arm_gripper_opening" type="revolute"><parent link="arm_gripper"/><child link="left_finger"/><origin xyz="0.0202 0.0188 -0.0234" rpy="1.5708 0 0"/><axis xyz="0 0 1"/><limit lower="-0.174533" upper="1.74533" effort="10" velocity="2"/></joint>
  <xacro:box_link name="right_finger" mass="0.03" x="0.070" y="0.012" z="0.018" material="yellow"/><joint name="right_finger_joint" type="fixed"><parent link="arm_gripper"/><child link="right_finger"/><origin xyz="0.0202 -0.0188 -0.0234" rpy="1.5708 0 0"/></joint>
</robot>
