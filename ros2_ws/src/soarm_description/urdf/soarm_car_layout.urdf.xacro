<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="kuruma">
  <!-- STEP mapping: +Z forward -> ROS +X, +X left -> ROS +Y, +Y up -> ROS +Z. -->
  <xacro:property name="wheel_radius" value="0.0763"/><xacro:property name="wheel_width" value="0.0481"/><xacro:property name="wheelbase" value="0.3472"/><xacro:property name="track" value="0.4456"/><xacro:property name="frame_square" value="0.600"/>
  <material name="extrusion"><color rgba="0.32 0.34 0.36 1"/></material><material name="wheel"><color rgba="0.06 0.06 0.06 1"/></material><material name="roller"><color rgba="0.72 0.72 0.70 1"/></material><material name="electronics"><color rgba="0.12 0.28 0.48 1"/></material><material name="provisional"><color rgba="0.08 0.68 0.78 1"/></material>
  <xacro:macro name="box" params="name mass x y z material"><link name="${name}"><inertial><mass value="${mass}"/><inertia ixx="${mass*(y*y+z*z)/12}" iyy="${mass*(x*x+z*z)/12}" izz="${mass*(x*x+y*y)/12}" ixy="0" ixz="0" iyz="0"/></inertial><visual><geometry><box size="${x} ${y} ${z}"/></geometry><material name="${material}"/></visual><collision><geometry><box size="${x} ${y} ${z}"/></geometry></collision></link></xacro:macro>
  <link name="base_footprint"/>
  <!-- Suspension height is provisional; CAD corners differ by about 19 mm vertically. -->
  <xacro:box name="base_link" mass="9.0" x="0.360" y="0.360" z="0.060" material="electronics"/><joint name="base_footprint_joint" type="fixed"><parent link="base_footprint"/><child link="base_link"/><origin xyz="0 0 ${wheel_radius}"/></joint>
  <!-- Measured 3030 extrusion perimeter, 0.600 m square. -->
  <xacro:box name="frame_front" mass="0.8" x="0.600" y="0.030" z="0.030" material="extrusion"/><joint name="frame_front_joint" type="fixed"><parent link="base_link"/><child link="frame_front"/><origin xyz="0 ${frame_square/2-0.015} 0"/></joint>
  <xacro:box name="frame_rear" mass="0.8" x="0.600" y="0.030" z="0.030" material="extrusion"/><joint name="frame_rear_joint" type="fixed"><parent link="base_link"/><child link="frame_rear"/><origin xyz="0 ${-frame_square/2+0.015} 0"/></joint>
  <xacro:box name="frame_left" mass="0.8" x="0.030" y="0.540" z="0.030" material="extrusion"/><joint name="frame_left_joint" type="fixed"><parent link="base_link"/><child link="frame_left"/><origin xyz="${frame_square/2-0.015} 0 0"/></joint>
  <xacro:box name="frame_right" mass="0.8" x="0.030" y="0.540" z="0.030" material="extrusion"/><joint name="frame_right_joint" type="fixed"><parent link="base_link"/><child link="frame_right"/><origin xyz="${-frame_square/2+0.015} 0 0"/></joint>
  <xacro:box name="electronics_envelope" mass="2.0" x="0.300" y="0.260" z="0.100" material="electronics"/><joint name="electronics_envelope_joint" type="fixed"><parent link="base_link"/><child link="electronics_envelope"/><origin xyz="0 0 0.070"/></joint>
  <xacro:macro name="mecanum_wheel" params="name x y roller_sign"><link name="${name}"><inertial><mass value="0.7"/><inertia ixx="0.002" iyy="0.001" izz="0.002" ixy="0" ixz="0" iyz="0"/></inertial><visual name="envelope"><origin rpy="-1.570796 0 0"/><geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry><material name="wheel"/></visual><collision name="envelope"><origin rpy="-1.570796 0 0"/><geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry></collision><visual name="roller_direction"><origin xyz="0 0 ${wheel_width/2+0.002}" rpy="0 ${roller_sign*0.785398} 0"/><geometry><box size="0.090 0.008 0.008"/></geometry><material name="roller"/></visual></link><joint name="${name}_joint" type="continuous"><parent link="base_link"/><child link="${name}"/><origin xyz="${x} ${y} 0"/><axis xyz="0 1 0"/></joint><xacro:box name="${name}_motor_placeholder" mass="0.35" x="0.100" y="0.055" z="0.055" material="extrusion"/><joint name="${name}_motor_placeholder_joint" type="fixed"><parent link="base_link"/><child link="${name}_motor_placeholder"/><origin xyz="${x} ${y*0.82} 0.025"/></joint></xacro:macro>
  <xacro:mecanum_wheel name="front_left_wheel" x="${wheelbase/2}" y="${track/2}" roller_sign="1"/><xacro:mecanum_wheel name="front_right_wheel" x="${wheelbase/2}" y="${-track/2}" roller_sign="-1"/><xacro:mecanum_wheel name="rear_left_wheel" x="${-wheelbase/2}" y="${track/2}" roller_sign="-1"/><xacro:mecanum_wheel name="rear_right_wheel" x="${-wheelbase/2}" y="${-track/2}" roller_sign="1"/>
  <!-- Provisional navigation mounts: preserved TF seams, not STEP-derived placements. -->
  <xacro:box name="gyro_link" mass="0.05" x="0.040" y="0.040" z="0.020" material="provisional"/><joint name="gyro_joint" type="fixed"><parent link="electronics_envelope"/><child link="gyro_link"/><origin xyz="0 0 0.060"/></joint><xacro:box name="camera_link" mass="0.12" x="0.085" y="0.035" z="0.032" material="provisional"/><joint name="camera_joint" type="fixed"><parent link="electronics_envelope"/><child link="camera_link"/><origin xyz="0.180 0 0.080"/></joint><link name="livox_frame"><visual><geometry><cylinder radius="0.036" length="0.060"/></geometry><material name="provisional"/></visual></link><joint name="livox_joint" type="fixed"><parent link="electronics_envelope"/><child link="livox_frame"/><origin xyz="0 0 0.100"/></joint>
  <!-- Isolated gz_ros2_control profile consumes these standard wheel interfaces. -->
  <ros2_control name="GazeboSimSystem" type="system">
    <hardware><plugin>gz_ros2_control/GazeboSimSystem</plugin></hardware>
    <joint name="front_left_wheel_joint"><command_interface name="velocity"/><state_interface name="position"/><state_interface name="velocity"/></joint>
    <joint name="front_right_wheel_joint"><command_interface name="velocity"/><state_interface name="position"/><state_interface name="velocity"/></joint>
    <joint name="rear_left_wheel_joint"><command_interface name="velocity"/><state_interface name="position"/><state_interface name="velocity"/></joint>
    <joint name="rear_right_wheel_joint"><command_interface name="velocity"/><state_interface name="position"/><state_interface name="velocity"/></joint>
  </ros2_control>
</robot>
