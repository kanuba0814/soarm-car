<?xml version="1.0"?>
<sdf version="1.9" xmlns:ignition="http://ignitionrobotics.org/schema">
  <model name="kuruma">
    <!-- STEP-derived planar geometry: wheel radius 0.0763, wheelbase 0.3472, track 0.4456, 3030 perimeter 0.600 square. Suspension height and masses are provisional. -->
    <link name="base_link"><pose relative_to="__model__">0 0 0.0763 0 0 0</pose><inertial><mass>12.0</mass><inertia><ixx>0.40</ixx><iyy>0.40</iyy><izz>0.70</izz></inertia></inertial><collision name="frame_front_collision"><pose>0 0.285 0 0 0 0</pose><geometry><box><size>0.600 0.030 0.030</size></box></geometry></collision><collision name="frame_rear_collision"><pose>0 -0.285 0 0 0 0</pose><geometry><box><size>0.600 0.030 0.030</size></box></geometry></collision><collision name="frame_left_collision"><pose>0.285 0 0 0 0 0</pose><geometry><box><size>0.030 0.540 0.030</size></box></geometry></collision><collision name="frame_right_collision"><pose>-0.285 0 0 0 0 0</pose><geometry><box><size>0.030 0.540 0.030</size></box></geometry></collision><collision name="electronics_collision"><geometry><box><size>0.360 0.360 0.060</size></box></geometry></collision><visual name="electronics"><geometry><box><size>0.360 0.360 0.060</size></box></geometry><material><diffuse>0.12 0.28 0.48 1</diffuse></material></visual><visual name="frame_front"><pose>0 0.285 0 0 0 0</pose><geometry><box><size>0.600 0.030 0.030</size></box></geometry></visual><visual name="frame_rear"><pose>0 -0.285 0 0 0 0</pose><geometry><box><size>0.600 0.030 0.030</size></box></geometry></visual><visual name="frame_left"><pose>0.285 0 0 0 0 0</pose><geometry><box><size>0.030 0.540 0.030</size></box></geometry></visual><visual name="frame_right"><pose>-0.285 0 0 0 0 0</pose><geometry><box><size>0.030 0.540 0.030</size></box></geometry></visual><visual name="electronics_envelope"><pose>0 0 0.070 0 0 0</pose><geometry><box><size>0.300 0.260 0.100</size></box></geometry></visual></link>
    <link name="front_left_wheel"><pose relative_to="base_link">0.1736 0.2228 0 -1.570796 0 0</pose><inertial><mass>0.7</mass><inertia><ixx>0.002</ixx><iyy>0.001</iyy><izz>0.002</izz></inertia></inertial><visual name="wheel"><geometry><cylinder><radius>0.0763</radius><length>0.0481</length></cylinder></geometry><material><diffuse>0.06 0.06 0.06 1</diffuse></material></visual><collision name="wheel_collision"><geometry><cylinder><radius>0.0763</radius><length>0.0481</length></cylinder></geometry><surface><friction><ode><mu>1.0</mu><mu2>0.0</mu2><fdir1 ignition:expressed_in="base_link">1 -1 0</fdir1></ode></friction></surface></collision></link>
    <link name="front_right_wheel"><pose relative_to="base_link">0.1736 -0.2228 0 -1.570796 0 0</pose><inertial><mass>0.7</mass><inertia><ixx>0.002</ixx><iyy>0.001</iyy><izz>0.002</izz></inertia></inertial><visual name="wheel"><geometry><cylinder><radius>0.0763</radius><length>0.0481</length></cylinder></geometry></visual><collision name="wheel_collision"><geometry><cylinder><radius>0.0763</radius><length>0.0481</length></cylinder></geometry><surface><friction><ode><mu>1.0</mu><mu2>0.0</mu2><fdir1 ignition:expressed_in="base_link">1 1 0</fdir1></ode></friction></surface></collision></link>
    <link name="rear_left_wheel"><pose relative_to="base_link">-0.1736 0.2228 0 -1.570796 0 0</pose><inertial><mass>0.7</mass><inertia><ixx>0.002</ixx><iyy>0.001</iyy><izz>0.002</izz></inertia></inertial><visual name="wheel"><geometry><cylinder><radius>0.0763</radius><length>0.0481</length></cylinder></geometry></visual><collision name="wheel_collision"><geometry><cylinder><radius>0.0763</radius><length>0.0481</length></cylinder></geometry><surface><friction><ode><mu>1.0</mu><mu2>0.0</mu2><fdir1 ignition:expressed_in="base_link">1 1 0</fdir1></ode></friction></surface></collision></link>
    <link name="rear_right_wheel"><pose relative_to="base_link">-0.1736 -0.2228 0 -1.570796 0 0</pose><inertial><mass>0.7</mass><inertia><ixx>0.002</ixx><iyy>0.001</iyy><izz>0.002</izz></inertia></inertial><visual name="wheel"><geometry><cylinder><radius>0.0763</radius><length>0.0481</length></cylinder></geometry></visual><collision name="wheel_collision"><geometry><cylinder><radius>0.0763</radius><length>0.0481</length></cylinder></geometry><surface><friction><ode><mu>1.0</mu><mu2>0.0</mu2><fdir1 ignition:expressed_in="base_link">1 -1 0</fdir1></ode></friction></surface></collision></link>
    <joint name="front_left_wheel_joint" type="revolute"><parent>base_link</parent><child>front_left_wheel</child><axis><xyz>0 1 0</xyz><limit><lower>-1.79769e+308</lower><upper>1.79769e+308</upper></limit></axis></joint><joint name="front_right_wheel_joint" type="revolute"><parent>base_link</parent><child>front_right_wheel</child><axis><xyz>0 1 0</xyz><limit><lower>-1.79769e+308</lower><upper>1.79769e+308</upper></limit></axis></joint><joint name="rear_left_wheel_joint" type="revolute"><parent>base_link</parent><child>rear_left_wheel</child><axis><xyz>0 1 0</xyz><limit><lower>-1.79769e+308</lower><upper>1.79769e+308</upper></limit></axis></joint><joint name="rear_right_wheel_joint" type="revolute"><parent>base_link</parent><child>rear_right_wheel</child><axis><xyz>0 1 0</xyz><limit><lower>-1.79769e+308</lower><upper>1.79769e+308</upper></limit></axis></joint>
    <!-- Provisional sensor mounts retained for navigation consumers; not STEP-derived. -->
    <link name="gyro_link"><pose relative_to="base_link">0 0 0.130 0 0 0</pose><sensor name="imu" type="imu"><topic>/gazebo/imu</topic><always_on>1</always_on><update_rate>50</update_rate></sensor></link><joint name="gyro_joint" type="fixed"><parent>base_link</parent><child>gyro_link</child></joint>
    <link name="camera_link"><pose relative_to="base_link">0.180 0 0.150 0 0 0</pose><sensor name="camera" type="rgbd_camera"><topic>/camera</topic><always_on>1</always_on><update_rate>30</update_rate><camera><horizontal_fov>1.047</horizontal_fov><image><width>640</width><height>480</height></image><clip><near>0.1</near><far>8</far></clip><depth_camera><clip><near>0.1</near><far>8</far></clip></depth_camera></camera></sensor></link><joint name="camera_joint" type="fixed"><parent>base_link</parent><child>camera_link</child></joint>
    <link name="livox_frame"><pose relative_to="base_link">0 0 0.170 0 0 0</pose><sensor name="mid360" type="gpu_lidar"><topic>/mid360/scan/points</topic><always_on>1</always_on><update_rate>10</update_rate><lidar><scan><horizontal><samples>720</samples><resolution>1</resolution><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal><vertical><samples>16</samples><resolution>1</resolution><min_angle>-0.4</min_angle><max_angle>0.4</max_angle></vertical></scan><range><min>0.1</min><max>20</max><resolution>0.01</resolution></range></lidar></sensor><sensor name="livox_imu" type="imu"><topic>/gazebo/livox_imu</topic><always_on>1</always_on><update_rate>50</update_rate></sensor></link><joint name="livox_joint" type="fixed"><parent>base_link</parent><child>livox_frame</child></joint>
    <plugin filename="ignition-gazebo-mecanum-drive-system" name="ignition::gazebo::systems::MecanumDrive"><front_left_joint>front_left_wheel_joint</front_left_joint><front_right_joint>front_right_wheel_joint</front_right_joint><back_left_joint>rear_left_wheel_joint</back_left_joint><back_right_joint>rear_right_wheel_joint</back_right_joint><wheel_separation>0.4456</wheel_separation><wheelbase>0.3472</wheelbase><wheel_radius>0.0763</wheel_radius><topic>/safe_cmd_vel</topic><odom_topic>/gazebo/odom</odom_topic><odom_publish_frequency>50</odom_publish_frequency><min_acceleration>-2.0</min_acceleration><max_acceleration>2.0</max_acceleration></plugin>
    <!-- Fortress 6 MecanumDrive accepts commands but does not emit odometry in its bundled example. Publish physical model-state odometry through the native companion system. -->
    <plugin filename="ignition-gazebo-odometry-publisher-system" name="ignition::gazebo::systems::OdometryPublisher"><odom_frame>kuruma/odom</odom_frame><robot_base_frame>kuruma/base_link</robot_base_frame><odom_publish_frequency>50</odom_publish_frequency><odom_topic>/gazebo/odom</odom_topic></plugin>
    <plugin filename="ignition-gazebo-joint-state-publisher-system" name="ignition::gazebo::systems::JointStatePublisher"><topic>/joint_states</topic></plugin>
  </model>
</sdf>
