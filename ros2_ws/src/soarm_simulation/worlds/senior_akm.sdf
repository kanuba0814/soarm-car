<?xml version="1.0"?>
<sdf version="1.9">
  <world name="senior_akm_lab">
    <physics name="1ms" type="dart"><max_step_size>0.001</max_step_size><real_time_factor>1</real_time_factor></physics>
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <plugin filename="ignition-gazebo-imu-system" name="ignition::gazebo::systems::Imu"/>
    <light type="directional" name="sun"><pose>0 0 10 0 0 0</pose><cast_shadows>true</cast_shadows><direction>-0.5 0.1 -0.9</direction></light>
    <model name="ground"><static>true</static><link name="link"><collision name="collision"><geometry><plane><normal>0 0 1</normal></plane></geometry></collision><visual name="visual"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry></visual></link></model>
    <model name="senior_akm">
      <!-- ENU vehicle convention: +X forward, +Y left, +Z up. Model origin is ground. -->
      <link name="base_link"><pose relative_to="__model__">0 0 0.0625 0 0 0</pose><inertial><mass>5</mass><inertia><ixx>0.06</ixx><iyy>0.08</iyy><izz>0.12</izz></inertia></inertial>
        <collision name="frame_collision"><geometry><box><size>0.400 0.260 0.040</size></box></geometry></collision><visual name="frame_visual"><geometry><box><size>0.400 0.260 0.040</size></box></geometry><material><diffuse>0.30 0.32 0.35 1</diffuse></material></visual>
      </link>
      <!-- Plates are deliberately separate from the 0.400 x 0.260 m chassis so tyres remain visible. -->
      <link name="first_deck"><pose relative_to="base_link">0 0 0.035 0 0 0</pose><inertial><mass>0.3</mass><inertia><ixx>0.002</ixx><iyy>0.004</iyy><izz>0.006</izz></inertia></inertial><collision name="c"><geometry><box><size>0.400 0.260 0.005</size></box></geometry></collision><visual name="v"><geometry><box><size>0.400 0.260 0.005</size></box></geometry><material><diffuse>0.78 0.80 0.82 1</diffuse></material></visual></link><joint name="first_deck_joint" type="fixed"><pose relative_to="first_deck">0 0 0 0 0 0</pose><parent>base_link</parent><child>first_deck</child></joint>
      <link name="second_deck"><pose relative_to="base_link">0 0 0.100 0 0 0</pose><inertial><mass>0.4</mass><inertia><ixx>0.003</ixx><iyy>0.005</iyy><izz>0.008</izz></inertia></inertial><collision name="c"><geometry><box><size>0.400 0.300 0.005</size></box></geometry></collision><visual name="v"><geometry><box><size>0.400 0.300 0.005</size></box></geometry><material><diffuse>0.78 0.80 0.82 1</diffuse></material></visual></link><joint name="second_deck_joint" type="fixed"><pose relative_to="second_deck">0 0 0 0 0 0</pose><parent>base_link</parent><child>second_deck</child></joint>
      <link name="third_deck"><pose relative_to="base_link">0 0 0.137 0 0 0</pose><inertial><mass>0.5</mass><inertia><ixx>0.004</ixx><iyy>0.007</iyy><izz>0.010</izz></inertia></inertial><collision name="c"><geometry><box><size>0.445 0.320 0.005</size></box></geometry></collision><visual name="v"><geometry><box><size>0.445 0.320 0.005</size></box></geometry><material><diffuse>0.78 0.80 0.82 1</diffuse></material></visual></link><joint name="third_deck_joint" type="fixed"><pose relative_to="third_deck">0 0 0 0 0 0</pose><parent>base_link</parent><child>third_deck</child></joint>
      <!-- Symmetric four-corner lower/upper standoffs: x=+-0.160, y=+-0.105. -->
      <link name="pillar_fl_lower"><pose relative_to="first_deck">0.160 0.105 0.0325 0 0 0</pose><visual name="v"><geometry><cylinder><radius>0.008</radius><length>0.060</length></cylinder></geometry><material><diffuse>0.65 0.67 0.70 1</diffuse></material></visual><collision name="c"><geometry><cylinder><radius>0.008</radius><length>0.060</length></cylinder></geometry></collision></link><joint name="pillar_fl_lower_joint" type="fixed"><pose relative_to="pillar_fl_lower">0 0 0 0 0 0</pose><parent>first_deck</parent><child>pillar_fl_lower</child></joint>
      <link name="pillar_fr_lower"><pose relative_to="first_deck">0.160 -0.105 0.0325 0 0 0</pose><visual name="v"><geometry><cylinder><radius>0.008</radius><length>0.060</length></cylinder></geometry><material><diffuse>0.65 0.67 0.70 1</diffuse></material></visual></link><joint name="pillar_fr_lower_joint" type="fixed"><pose relative_to="pillar_fr_lower">0 0 0 0 0 0</pose><parent>first_deck</parent><child>pillar_fr_lower</child></joint>
      <link name="pillar_rl_lower"><pose relative_to="first_deck">-0.160 0.105 0.0325 0 0 0</pose><visual name="v"><geometry><cylinder><radius>0.008</radius><length>0.060</length></cylinder></geometry><material><diffuse>0.65 0.67 0.70 1</diffuse></material></visual></link><joint name="pillar_rl_lower_joint" type="fixed"><pose relative_to="pillar_rl_lower">0 0 0 0 0 0</pose><parent>first_deck</parent><child>pillar_rl_lower</child></joint>
      <link name="pillar_rr_lower"><pose relative_to="first_deck">-0.160 -0.105 0.0325 0 0 0</pose><visual name="v"><geometry><cylinder><radius>0.008</radius><length>0.060</length></cylinder></geometry><material><diffuse>0.65 0.67 0.70 1</diffuse></material></visual></link><joint name="pillar_rr_lower_joint" type="fixed"><pose relative_to="pillar_rr_lower">0 0 0 0 0 0</pose><parent>first_deck</parent><child>pillar_rr_lower</child></joint>
      <link name="pillar_fl_upper"><pose relative_to="second_deck">0.160 0.120 0.0185 0 0 0</pose><visual name="v"><geometry><cylinder><radius>0.008</radius><length>0.032</length></cylinder></geometry><material><diffuse>0.65 0.67 0.70 1</diffuse></material></visual></link><joint name="pillar_fl_upper_joint" type="fixed"><pose relative_to="pillar_fl_upper">0 0 0 0 0 0</pose><parent>second_deck</parent><child>pillar_fl_upper</child></joint>
      <link name="pillar_fr_upper"><pose relative_to="second_deck">0.160 -0.120 0.0185 0 0 0</pose><visual name="v"><geometry><cylinder><radius>0.008</radius><length>0.032</length></cylinder></geometry><material><diffuse>0.65 0.67 0.70 1</diffuse></material></visual></link><joint name="pillar_fr_upper_joint" type="fixed"><pose relative_to="pillar_fr_upper">0 0 0 0 0 0</pose><parent>second_deck</parent><child>pillar_fr_upper</child></joint>
      <link name="pillar_rl_upper"><pose relative_to="second_deck">-0.160 0.120 0.0185 0 0 0</pose><visual name="v"><geometry><cylinder><radius>0.008</radius><length>0.032</length></cylinder></geometry><material><diffuse>0.65 0.67 0.70 1</diffuse></material></visual></link><joint name="pillar_rl_upper_joint" type="fixed"><pose relative_to="pillar_rl_upper">0 0 0 0 0 0</pose><parent>second_deck</parent><child>pillar_rl_upper</child></joint>
      <link name="pillar_rr_upper"><pose relative_to="second_deck">-0.160 -0.120 0.0185 0 0 0</pose><visual name="v"><geometry><cylinder><radius>0.008</radius><length>0.032</length></cylinder></geometry><material><diffuse>0.65 0.67 0.70 1</diffuse></material></visual></link><joint name="pillar_rr_upper_joint" type="fixed"><pose relative_to="pillar_rr_upper">0 0 0 0 0 0</pose><parent>second_deck</parent><child>pillar_rr_upper</child></joint>
      <!-- Wheel link frames remain unrotated; only cylinder geometries rotate from Z to Y. -->
      <link name="left_front_steering_link"><pose relative_to="base_link">0.1725 0.155 0 0 0 0</pose><visual name="hub"><geometry><cylinder><radius>0.025</radius><length>0.050</length></cylinder></geometry><pose>0 0 0 -1.570796 0 0</pose><material><diffuse>0.62 0.64 0.67 1</diffuse></material></visual></link><joint name="left_front_steering_joint" type="revolute"><pose relative_to="left_front_steering_link">0 0 0 0 0 0</pose><parent>base_link</parent><child>left_front_steering_link</child><axis><xyz>0 0 1</xyz><limit><lower>-0.65</lower><upper>0.65</upper><effort>1000000</effort></limit></axis></joint>
      <link name="right_front_steering_link"><pose relative_to="base_link">0.1725 -0.155 0 0 0 0</pose><visual name="hub"><geometry><cylinder><radius>0.025</radius><length>0.050</length></cylinder></geometry><pose>0 0 0 -1.570796 0 0</pose><material><diffuse>0.62 0.64 0.67 1</diffuse></material></visual></link><joint name="right_front_steering_joint" type="revolute"><pose relative_to="right_front_steering_link">0 0 0 0 0 0</pose><parent>base_link</parent><child>right_front_steering_link</child><axis><xyz>0 0 1</xyz><limit><lower>-0.65</lower><upper>0.65</upper><effort>1000000</effort></limit></axis></joint>
      <link name="left_front_wheel"><pose relative_to="left_front_steering_link">0 0 0 0 0 0</pose><inertial><mass>0.35</mass><inertia><ixx>0.0008</ixx><iyy>0.00045</iyy><izz>0.0008</izz></inertia></inertial><collision name="tire"><pose>-0 0 0 -1.570796 0 0</pose><geometry><cylinder><radius>0.0625</radius><length>0.040</length></cylinder></geometry><surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface></collision><visual name="tire_visual"><pose>0 0 0 -1.570796 0 0</pose><geometry><cylinder><radius>0.0625</radius><length>0.040</length></cylinder></geometry><material><diffuse>0.03 0.03 0.03 1</diffuse></material></visual></link><joint name="left_front_wheel_joint" type="revolute"><pose relative_to="left_front_wheel">0 0 0 0 0 0</pose><parent>left_front_steering_link</parent><child>left_front_wheel</child><axis><xyz>0 1 0</xyz></axis></joint>
      <link name="right_front_wheel"><pose relative_to="right_front_steering_link">0 0 0 0 0 0</pose><inertial><mass>0.35</mass><inertia><ixx>0.0008</ixx><iyy>0.00045</iyy><izz>0.0008</izz></inertia></inertial><collision name="tire"><pose>0 0 0 -1.570796 0 0</pose><geometry><cylinder><radius>0.0625</radius><length>0.040</length></cylinder></geometry><surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface></collision><visual name="tire_visual"><pose>0 0 0 -1.570796 0 0</pose><geometry><cylinder><radius>0.0625</radius><length>0.040</length></cylinder></geometry><material><diffuse>0.03 0.03 0.03 1</diffuse></material></visual></link><joint name="right_front_wheel_joint" type="revolute"><pose relative_to="right_front_wheel">0 0 0 0 0 0</pose><parent>right_front_steering_link</parent><child>right_front_wheel</child><axis><xyz>0 1 0</xyz></axis></joint>
      <link name="left_rear_wheel"><pose relative_to="base_link">-0.1725 0.155 0 0 0 0</pose><inertial><mass>0.35</mass><inertia><ixx>0.0008</ixx><iyy>0.00045</iyy><izz>0.0008</izz></inertia></inertial><collision name="tire"><pose>0 0 0 -1.570796 0 0</pose><geometry><cylinder><radius>0.0625</radius><length>0.040</length></cylinder></geometry><surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface></collision><visual name="tire_visual"><pose>0 0 0 -1.570796 0 0</pose><geometry><cylinder><radius>0.0625</radius><length>0.040</length></cylinder></geometry><material><diffuse>0.03 0.03 0.03 1</diffuse></material></visual></link><joint name="left_rear_wheel_joint" type="revolute"><pose relative_to="left_rear_wheel">0 0 0 0 0 0</pose><parent>base_link</parent><child>left_rear_wheel</child><axis><xyz>0 1 0</xyz></axis></joint>
      <link name="right_rear_wheel"><pose relative_to="base_link">-0.1725 -0.155 0 0 0 0</pose><inertial><mass>0.35</mass><inertia><ixx>0.0008</ixx><iyy>0.00045</iyy><izz>0.0008</izz></inertia></inertial><collision name="tire"><pose>0 0 0 -1.570796 0 0</pose><geometry><cylinder><radius>0.0625</radius><length>0.040</length></cylinder></geometry><surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface></collision><visual name="tire_visual"><pose>0 0 0 -1.570796 0 0</pose><geometry><cylinder><radius>0.0625</radius><length>0.040</length></cylinder></geometry><material><diffuse>0.03 0.03 0.03 1</diffuse></material></visual></link><joint name="right_rear_wheel_joint" type="revolute"><pose relative_to="right_rear_wheel">0 0 0 0 0 0</pose><parent>base_link</parent><child>right_rear_wheel</child><axis><xyz>0 1 0</xyz></axis></joint>
      <!-- Sensors are positioned from their owning deck frames. -->
      <link name="gyro_link"><pose relative_to="second_deck">0 0 0.0185 0 0 0</pose><visual name="v"><geometry><box><size>0.040 0.040 0.020</size></box></geometry><material><diffuse>0.50 0.18 0.65 1</diffuse></material></visual><sensor name="imu" type="imu"><topic>/gazebo/imu</topic><update_rate>50</update_rate><always_on>true</always_on></sensor></link><joint name="gyro_joint" type="fixed"><pose relative_to="gyro_link">0 0 0 0 0 0</pose><parent>second_deck</parent><child>gyro_link</child></joint>
      <link name="camera_link"><pose relative_to="second_deck">0.1725 0 0.0185 0 0 0</pose><visual name="body"><geometry><box><size>0.085 0.035 0.032</size></box></geometry><material><diffuse>0.08 0.30 0.80 1</diffuse></material></visual><visual name="lens"><pose>0.043 0 0 0 1.570796 0</pose><geometry><cylinder><radius>0.012</radius><length>0.004</length></cylinder></geometry><material><diffuse>0.01 0.01 0.01 1</diffuse></material></visual><sensor name="rgbd" type="rgbd_camera"><topic>/camera</topic><update_rate>15</update_rate><camera><image><width>640</width><height>480</height><format>R8G8B8</format></image><clip><near>0.1</near><far>8</far></clip></camera></sensor></link><joint name="camera_joint" type="fixed"><pose relative_to="camera_link">0 0 0 0 0 0</pose><parent>second_deck</parent><child>camera_link</child></joint>
      <link name="livox_frame"><pose relative_to="third_deck">0 0 0.0325 0 0 0</pose><visual name="v"><geometry><cylinder><radius>0.036</radius><length>0.060</length></cylinder></geometry><material><diffuse>0.05 0.75 0.85 1</diffuse></material></visual><sensor name="mid360_approx" type="gpu_lidar"><topic>/mid360/scan</topic><update_rate>10</update_rate><lidar><scan><horizontal><samples>900</samples><resolution>1</resolution><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal><vertical><samples>16</samples><min_angle>-0.35</min_angle><max_angle>0.35</max_angle></vertical></scan><range><min>0.1</min><max>40</max></range></lidar></sensor></link><joint name="livox_joint" type="fixed"><pose relative_to="livox_frame">0 0 0 0 0 0</pose><parent>third_deck</parent><child>livox_frame</child></joint>
      <!-- Official SO101 calibrated zero transforms, retaining project controller joint names. -->
      <link name="arm_mount"><gravity>false</gravity><pose relative_to="third_deck">0.1725 0 0.0025 0 0 0</pose><visual name="v"><geometry><box><size>0.10 0.10 0.035</size></box></geometry><material><diffuse>0.18 0.19 0.21 1</diffuse></material></visual></link><joint name="arm_mount_joint" type="fixed"><pose relative_to="arm_mount">0 0 0 0 0 0</pose><parent>third_deck</parent><child>arm_mount</child></joint>
      <link name="arm_shoulder"><gravity>false</gravity><pose relative_to="arm_mount">0.0388353 -0.000000009 0.0624 3.14159 0 -3.14159</pose><visual name="housing"><geometry><box><size>0.055 0.055 0.065</size></box></geometry><material><diffuse>0.18 0.19 0.21 1</diffuse></material></visual><visual name="link"><pose>-0.0152 -0.00914 -0.0271 0.3218 -0.0 -2.599</pose><geometry><box><size>0.0647 0.025 0.025</size></box></geometry><material><diffuse>0.95 0.40 0.05 1</diffuse></material></visual></link><joint name="arm_shoulder_pan" type="revolute"><pose relative_to="arm_shoulder">0 0 0 0 0 0</pose><parent>arm_mount</parent><child>arm_shoulder</child><axis><xyz>0 0 1</xyz><limit><lower>-1.91986</lower><upper>1.91986</upper><effort>10</effort><velocity>2</velocity></limit><dynamics><damping>1.5</damping></dynamics></axis></joint>
      <link name="arm_upper"><gravity>false</gravity><pose relative_to="arm_shoulder">-0.0303992 -0.0182778 -0.0542 -1.5708 -1.5708 0</pose><visual name="housing"><geometry><box><size>0.050 0.050 0.050</size></box></geometry><material><diffuse>0.18 0.19 0.21 1</diffuse></material></visual><visual name="link"><pose>-0.056285 -0.014 0 0 0 -2.898</pose><geometry><box><size>0.116 0.028 0.028</size></box></geometry><material><diffuse>0.95 0.40 0.05 1</diffuse></material></visual></link><joint name="arm_shoulder_lift" type="revolute"><pose relative_to="arm_upper">0 0 0 0 0 0</pose><parent>arm_shoulder</parent><child>arm_upper</child><axis><xyz>0 0 1</xyz><limit><lower>-1.74533</lower><upper>1.74533</upper><effort>10</effort><velocity>2</velocity></limit><dynamics><damping>1.5</damping></dynamics></axis></joint>
      <link name="arm_forearm"><gravity>false</gravity><pose relative_to="arm_upper">-0.11257 -0.028 0 0 0 1.5708</pose><visual name="housing"><geometry><box><size>0.045 0.045 0.045</size></box></geometry><material><diffuse>0.18 0.19 0.21 1</diffuse></material></visual><visual name="link"><pose>-0.06745 0.0026 0 0 0 3.103</pose><geometry><box><size>0.135 0.025 0.025</size></box></geometry><material><diffuse>0.95 0.40 0.05 1</diffuse></material></visual></link><joint name="arm_elbow_flex" type="revolute"><pose relative_to="arm_forearm">0 0 0 0 0 0</pose><parent>arm_upper</parent><child>arm_forearm</child><axis><xyz>0 0 1</xyz><limit><lower>-1.69</lower><upper>1.69</upper><effort>10</effort><velocity>2</velocity></limit><dynamics><damping>1.2</damping></dynamics></axis></joint>
      <link name="arm_wrist"><gravity>false</gravity><pose relative_to="arm_forearm">-0.1349 0.0052 0 0 0 -1.5708</pose><visual name="housing"><geometry><box><size>0.040 0.040 0.040</size></box></geometry><material><diffuse>0.18 0.19 0.21 1</diffuse></material></visual><visual name="link"><pose>0 -0.03055 0.00905 -0.288 0 1.5708</pose><geometry><box><size>0.0637 0.022 0.022</size></box></geometry><material><diffuse>0.95 0.40 0.05 1</diffuse></material></visual></link><joint name="arm_wrist_flex" type="revolute"><pose relative_to="arm_wrist">0 0 0 0 0 0</pose><parent>arm_forearm</parent><child>arm_wrist</child><axis><xyz>0 0 1</xyz><limit><lower>-1.65806</lower><upper>1.65806</upper><effort>10</effort><velocity>2</velocity></limit><dynamics><damping>1.0</damping></dynamics></axis></joint>
      <link name="arm_gripper"><gravity>false</gravity><pose relative_to="arm_wrist">0 -0.0611 0.0181 1.5708 0.0486795 3.14159</pose><visual name="housing"><geometry><box><size>0.060 0.050 0.050</size></box></geometry><material><diffuse>0.18 0.19 0.21 1</diffuse></material></visual></link><joint name="arm_wrist_roll" type="revolute"><pose relative_to="arm_gripper">0 0 0 0 0 0</pose><parent>arm_wrist</parent><child>arm_gripper</child><axis><xyz>0 0 1</xyz><limit><lower>-2.74385</lower><upper>2.84121</upper><effort>10</effort><velocity>2</velocity></limit><dynamics><damping>0.8</damping></dynamics></axis></joint>
      <link name="left_finger"><gravity>false</gravity><pose relative_to="arm_gripper">0.0202 0.0188 -0.0234 1.5708 0 0</pose><visual name="v"><geometry><box><size>0.070 0.012 0.018</size></box></geometry><material><diffuse>0.98 0.76 0.05 1</diffuse></material></visual></link><joint name="arm_gripper_opening" type="revolute"><pose relative_to="left_finger">0 0 0 0 0 0</pose><parent>arm_gripper</parent><child>left_finger</child><axis><xyz>0 0 1</xyz><limit><lower>-0.174533</lower><upper>1.74533</upper><effort>10</effort><velocity>2</velocity></limit><dynamics><damping>0.4</damping></dynamics></axis></joint>
      <link name="right_finger"><gravity>false</gravity><pose relative_to="arm_gripper">0.0202 -0.0188 -0.0234 1.5708 0 0</pose><visual name="v"><geometry><box><size>0.070 0.012 0.018</size></box></geometry><material><diffuse>0.98 0.76 0.05 1</diffuse></material></visual></link><joint name="right_finger_joint" type="fixed"><pose relative_to="right_finger">0 0 0 0 0 0</pose><parent>arm_gripper</parent><child>right_finger</child></joint>
      <plugin filename="ignition-gazebo-ackermann-steering-system" name="ignition::gazebo::systems::AckermannSteering"><topic>/cmd_vel</topic><left_joint>left_rear_wheel_joint</left_joint><right_joint>right_rear_wheel_joint</right_joint><left_steering_joint>left_front_steering_joint</left_steering_joint><right_steering_joint>right_front_steering_joint</right_steering_joint><kingpin_width>0.310</kingpin_width><steering_limit>0.407</steering_limit><wheel_base>0.345</wheel_base><wheel_separation>0.310</wheel_separation><wheel_radius>0.0625</wheel_radius><min_velocity>-0.4</min_velocity><max_velocity>0.4</max_velocity><min_acceleration>-2</min_acceleration><max_acceleration>2</max_acceleration><odom_publish_frequency>50</odom_publish_frequency><odom_topic>/gazebo/odom</odom_topic></plugin>
      <plugin filename="ignition-gazebo-joint-state-publisher-system" name="ignition::gazebo::systems::JointStatePublisher"><topic>/joint_states</topic><joint_name>left_front_steering_joint</joint_name><joint_name>right_front_steering_joint</joint_name><joint_name>left_front_wheel_joint</joint_name><joint_name>right_front_wheel_joint</joint_name><joint_name>left_rear_wheel_joint</joint_name><joint_name>right_rear_wheel_joint</joint_name><joint_name>arm_shoulder_pan</joint_name><joint_name>arm_shoulder_lift</joint_name><joint_name>arm_elbow_flex</joint_name><joint_name>arm_wrist_flex</joint_name><joint_name>arm_wrist_roll</joint_name><joint_name>arm_gripper_opening</joint_name></plugin>
