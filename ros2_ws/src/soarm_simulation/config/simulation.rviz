Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 18; 21; 27
    Fixed Frame: map
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Ground grid
      Enabled: true
      Alpha: 0.45
      Cell Size: 0.25
      Color: 90; 98; 110
      Plane: XY
    - Class: rviz_default_plugins/Map
      Name: Navigation map
      Enabled: true
      Topic:
        Value: /map
        Durability Policy: Transient Local
      Alpha: 0.55
      Color Scheme: map
    - Class: rviz_default_plugins/RobotModel
      Name: Live robot pose
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
      Visual Enabled: true
      Collision Enabled: false
    - Class: rviz_default_plugins/TF
      Name: TF tree
      Enabled: true
      Frame Timeout: 15
      Marker Scale: 0.12
      Show Arrows: true
      Show Axes: true
      Show Names: false
    - Class: rviz_default_plugins/Odometry
      Name: Current odometry
      Enabled: true
      Topic:
        Value: /odom
      Keep: 100
      Shape:
        Value: Arrow
      Color: 255; 80; 80
    - Class: rviz_default_plugins/Path
      Name: Driven path
      Enabled: true
      Topic:
        Value: /odom_path
      Line Style: Lines
      Line Width: 0.025
      Color: 255; 180; 30
      Buffer Length: 1
    - Class: rviz_default_plugins/Path
      Name: Global plan
      Enabled: true
      Topic:
        Value: /plan
      Line Style: Lines
      Line Width: 0.035
      Color: 80; 210; 255
      Buffer Length: 1
    - Class: rviz_default_plugins/Path
      Name: Local plan
      Enabled: true
      Topic:
        Value: /local_plan
      Line Style: Lines
      Line Width: 0.045
      Color: 255; 80; 190
      Buffer Length: 1
    - Class: rviz_default_plugins/Map
      Name: Global costmap
      Enabled: true
      Topic:
        Value: /global_costmap/costmap
        Durability Policy: Transient Local
      Alpha: 0.28
      Color Scheme: costmap
      Draw Behind: true
    - Class: rviz_default_plugins/Map
      Name: Local costmap
      Enabled: true
      Topic:
        Value: /local_costmap/costmap
        Durability Policy: Transient Local
      Alpha: 0.35
      Color Scheme: costmap
      Draw Behind: false
    - Class: rviz_default_plugins/PointCloud2
      Name: MID-360 approximation
      Enabled: true
      Topic:
        Value: /mid360/points
      Queue Size: 5
      Size (Pixels): 2
      Style: Points
      Color Transformer: AxisColor
      Axis: Z
      Decay Time: 0.3
    - Class: rviz_default_plugins/Image
      Name: RGB camera
      Enabled: false
      Topic:
        Value: /camera/image
      Normalize Range: true
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 1.6
      Focal Point:
        X: 0
        Y: 0
        Z: 0.20
      Pitch: 0.45
      Yaw: 0.75
Window Geometry:
  Height: 850
  Width: 1180
  X: 1180
  Y: 60
