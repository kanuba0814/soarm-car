<?xml version="1.0"?>
<package format="3">
  <name>soarm_navigation</name>
  <version>0.1.0</version>
  <description>Nav2 configuration and launch files for the SOARM Fortress simulation.</description>
  <maintainer email="maintainers@example.com">SOARM maintainers</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>fast_lio_localization</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_common</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>nav2_rotation_shim_controller</exec_depend>
  <exec_depend>soarm_interfaces</exec_depend>
  <exec_depend>soarm_simulation</exec_depend>
  <exec_depend>soarm_fixed_map_localization</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>turn_on_wheeltec_robot</exec_depend>
