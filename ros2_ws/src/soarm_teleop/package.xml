<?xml version="1.0"?>
<package format="3">
  <name>soarm_teleop</name>
  <version>0.1.0</version>
  <description>Keyboard teleop on the shared Twist command seam plus the STM32F405 mecanum chassis serial adapter.</description>
  <maintainer email="maintainers@example.com">SOARM maintainers</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-serial</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>soarm_navigation</exec_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
